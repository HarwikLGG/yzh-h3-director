{
  "name": "dsh-vision-bridge",
  "version": "0.2.0",
  "description": "识图桥接插件：把用户消息里的图片交给用户指定的视觉 API 模型识别（自动缩小大图、逐字转录文字、多图序号上下文），将文本描述转发给 DeepSeek 本体。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": ">=3.18.0",
    "@deepseek-ai/dsh-credentials": ">=0.0.1-rc.3",
    "@deepseek-ai/dsh-launch-environment": ">=0.0.1-rc.3",
    "@deepseek-ai/dsh-settings": ">=0.0.1-rc.3",
    "@deepseek-ai/cordis": ">=4.0.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.0.1-rc.1"
  }
}